                </mxCell>
                <mxCell id="pg-claire-t4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="ตัวหนา = PK · UK = ห้ามซ้ำ · เส้นปลายตีนกา = ฝั่งหลาย · เส้นประแดง = อนุมาน · ชื่อตารางเป็น snake_case" vertex="1">
