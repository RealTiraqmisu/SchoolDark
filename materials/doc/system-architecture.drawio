            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% กำหนดสีตกแต่งให้แต่ละส่วน\n    classDef frontend fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;\n    classDef gateway fill:#ffe0b2,stroke:#ef6c00,stroke-width:2px;\n    classDef myteam fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef backend fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;\n    classDef db fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px;\n    classDef storage fill:#eceff1,stroke:#455a64,stroke-width:2px;\n\n    subgraph L1 [\&quot;1. ชั้นส่วนติดต่อผู้ใช้งาน (Frontend)\&quot;]\n        Web[\&quot;Unified Web Portal\\n(React / Next.js)\&quot;]:::frontend\n    end\n\n    subgraph L2 [\&quot;2. ชั้นตัวจัดการจราจร (API Gateway)\&quot;]\n        Nginx[\&quot;Nginx\\n(Load Balancer)\&quot;]:::gateway\n    end\n\n    subgraph L3 [\&quot;3. ชั้นเซิร์ฟเวอร์ (Backend Microservices) - รันใน VM เดียวกัน\&quot;]\n        ServiceA[\&quot;Team A\\n(ระบบวิชาการ)\&quot;]:::backend\n        ServiceB[\&quot;Team B\\n(ระบบงานทะเบียน &amp; IAM)\&quot;]:::myteam\n        ServiceC[\&quot;Team C\\n(ระบบใหม่)\&quot;]:::backend\n    end\n\n    subgraph L4 [\&quot;4. ชั้นฐานข้อมูล (Database) - 1 Container แยก Schema\&quot;]\n        SchemaA[(\&quot;Schema: academic\\n(สิทธิ์เฉพาะ Team A)\&quot;)]:::db\n        SchemaB[(\&quot;Schema: admission\\n(สิทธิ์เฉพาะ Team B)\&quot;)]:::db\n        SchemaC[(\&quot;Schema: domain_c\\n(สิทธิ์เฉพาะ Team C)\&quot;)]:::db\n    end\n    \n    subgraph L5 [\&quot;5. ชั้นทรัพยากรส่วนกลาง (Shared Resources)\&quot;]\n        MinIO[(\&quot;MinIO\\n(เก็บไฟล์แนบ/รูปภาพ)\&quot;)]:::storage\n        Redis[\&quot;Redis &amp; Celery\\n(ประมวลผลพื้นหลัง)\&quot;]:::storage\n    end\n\n    %% การเชื่อมต่อจาก Frontend ไป Nginx\n    Web --&gt;|HTTP Requests| Nginx\n\n    %% การส่งต่อ Request จาก Nginx ไปแต่ละ Team\n    Nginx --&gt;|/api/academic| ServiceA\n    Nginx --&gt;|/api/admission| ServiceB\n    Nginx --&gt;|/api/team-c| ServiceC\n\n    %% การทำงานข้ามโดเมนผ่าน API\n    ServiceA -.-&gt;|Internal API: ยืนยันสิทธิ์ &amp; ขอข้อมูลนักเรียน| ServiceB\n    ServiceC -.-&gt;|Internal API: ยืนยันสิทธิ์ &amp; ขอข้อมูลนักเรียน| ServiceB\n\n    %% การเชื่อมต่อฐานข้อมูล\n    ServiceA ===&gt;|Read / Write| SchemaA\n    ServiceB ===&gt;|Read / Write| SchemaB\n    ServiceC ===&gt;|Read / Write| SchemaC\n\n    %% การใช้งาน Shared Resources\n    ServiceA ---&gt; MinIO\n    ServiceB ---&gt; MinIO\n    ServiceC ---&gt; MinIO\n    ServiceB ---&gt; Redis&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t9j-IwHOy3SKqKrkhznE-83">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
