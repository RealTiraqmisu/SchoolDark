    <diagram name="Copy of ER ทั้งระบบ (ต้นฉบับ · แก้ที่นี่ที่เดียว) v3" id="BEvaaprRZ92RsksUyfKQ">
        <mxGraphModel dx="6935" dy="4888" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="JK8i8bq7FqXSCipR4cN1-0"/>
                <mxCell id="JK8i8bq7FqXSCipR4cN1-1" parent="JK8i8bq7FqXSCipR4cN1-0"/>
                <mxCell id="JK8i8bq7FqXSCipR4cN1-2" parent="JK8i8bq7FqXSCipR4cN1-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#b91c1c;" value="ER ทั้งระบบ (ต้นฉบับ) · ทุกตาราง ทุกคอลัมน์ · แก้ที่แท็บนี้ที่เดียว · แท็บ &quot;ER · …&quot; รายฟีเจอร์สร้างจากแท็บนี้ด้วยสคริปต์ (ห้ามแก้ที่นั่น) · plan 211 · 2026-11-06 · ยังไม่ตรวจใน draw.io" vertex="1">
                    <mxGeometry height="30" width="3300" x="-1500" y="-190" as="geometry"/>
                </mxCell>
                <mxCell id="JK8i8bq7FqXSCipR4cN1-3" parent="JK8i8bq7FqXSCipR4cN1-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="สี: ฟ้า = เนยสด · เหลือง = แคร์ · เขียว (แถว/เส้น) = เพิ่ม/เปลี่ยนจาก grill · เทา = กล่องผี · ชมพู = อ้างอิงที่อยู่ · ม่วง = ต้องถามก่อน (ตารางลา/บัตร ยังไม่มีไฟล์ final ของแคร์) · 🟡 = คำอธิบายที่เลขาเขียนเอง · คอลัมน์: PK คีย์หลัก · FK คีย์อ้างอิง · UK ห้ามซ้ำ · เส้นปลายตีนกา = ฝั่งหลาย" vertex="1">
                    <mxGeometry height="45" width="3300" x="-1500" y="-150" as="geometry"/>
                </mxCell>
                <mxCell id="JK8i8bq7FqXSCipR4cN1-4" parent="JK8i8bq7FqXSCipR4cN1-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d4ed8;" value="ตารางอยู่แท็บย่อยไหน — รับสมัคร (9): admission_round course_plan exam_room application applicant_address applicant_guardian applicant_health application_document application_status_history · ทะเบียนนักเรียน (7): student student_address student_health student_guardian student_class_history classroom classroom_homeroom_teacher · ตั้งค่าโรงเรียน (12): EducationLevels AcademicYears Semesters SchoolSchedule SchoolCalendar study_program school_room system_setting field_definition student_column_setting email_template activity_log · บุคลากร (13): Employees Education RoyalDecorations License ToeicScore JobDetails Training FamilyMember Address SubDistricts Districts Provinces Countries · ลา/บัตร (6): student_leave_type student_leave_setting_type student_leave_setting_approver student_leave_form student_leave_approval tardy_slip" vertex="1">
                    <mxGeometry height="70" width="3300" x="-1500" y="-100" as="geometry"/>
