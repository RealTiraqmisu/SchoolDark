          <mxGeometry height="30" width="1500" x="40" y="56" as="geometry" />
        </mxCell>
        <mxCell id="pg-claire-t187" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#b91c1c;" value="student_leave_setting_approver ไม่ลากเส้น: Figma ไม่มีเส้นเชื่อม และคอลัมน์เหมือน setting_type ดูเหมือนก๊อปมา 🟡 address ชี้ 4 ตารางตามไฟล์ปัจจุบัน แต่แคลร์เขียนโน้ตใน Figma ว่าจะเหลือแค่ตำบล + postcode 🟡" vertex="1">
          <mxGeometry height="70" width="1500" x="60" y="3020" as="geometry" />
        </mxCell>
