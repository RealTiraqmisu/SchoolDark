th="175" height="70" as="geometry"/></mxCell><mxCell id="e-POS-dPS-32" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;strokeWidth=2;fontStyle=1;fontSize=22;fontFamily=TH SarabunPSK;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="POS" target="dPS"><mxGeometry relative="1" x="0.55" as="geometry"></mxGeometry></mxCell><mxCell id="e-dPS-PST-33" value="N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;strokeWidth=2;fontStyle=1;fontSize=22;fontFamily=TH SarabunPSK;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dPS" target="PST"><mxGeometry relative="1" x="-0.6" as="geometry"><Array as="points"><mxPoint x="1180" y="360"/><mxPoint x="1118.75" y="360"/></Array></mxGeometry></mxCell><mxCell id="note" value="ตารางตั้งค่าที่ไม่มีความสัมพันธ์กับตารางอื่น" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=22;fontStyle=2;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="480" height="34" as="geometry"/></mxCell><mxCell id="SWT" value="StaffWorkTime" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=TH SarabunPSK;html=1;whiteSpace=wrap;fontSize=24;" vertex="1" parent="1"><mxGeometry x="907.5" y="660" width="185" height="56" as="geometry"/></mxCell><mxCell id="SHF" value="Shift" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=TH SarabunPSK;html=1;whiteSpace=wrap;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1167.5" y="660" width="125" height="56" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;3.4.5 กลุ่มตารางการตั้งค่างานบุคลากร&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=48;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="72" as="geometry"/></mxCell><mxCell id="tcount" value="11 ตาราง" style="text;html=1;align=right;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=32;fontColor=#fde68a;" vertex="1" parent="1"><mxGeometry x="1620" y="14" width="260" height="72" as="geometry"/></mxCell><mxCell id="ptxt" value="&lt;font color='#1f3a5f'&gt;&lt;b&gt;กลุ่มนี้เก็บอะไร&lt;/b&gt;&lt;/font&gt;&lt;br&gt;ค่าตั้งต้นของงานบุคคล ได้แก่ ประเภท ตำแหน่ง แผนก เวลาทำงาน กะ บัญชีผู้ใช้ สิทธิ์ และผู้ลงนาม&lt;br&gt;&lt;br&gt;&lt;font color='#1f3a5f'&gt;&lt;b&gt;ตารางหลัก&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• User — บัญชีผู้ใช้&lt;br&gt;• Permission — สิทธิ์&lt;br&gt;• Department — แผนก&lt;br&gt;&lt;br&gt;&lt;font color='#1f3a5f'&gt;&lt;b&gt;จุดออกแบบ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;บุคลากร 1 คนมีบัญชีได้ 1 บัญชี และกำหนดสิทธิ์รายคนผ่าน UserPermission&lt;br&gt;&lt;br&gt;&lt;font color='#1f3a5f'&gt;&lt;b&gt;เชื่อมกลุ่มอื่น&lt;/b&gt;&lt;/font&gt;&lt;br&gt;JobDetails (บุคลากร) อ้างประเภท ตำแหน่ง แผนก จากที่นี่" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=TH SarabunPSK;fontSize=30;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1445" y="150" width="410" height="660" as="geometry"/></mxCell><mxCell id="lgh" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=24;fontColor=#1f3a5f;" vertex="1" parent="1"><mxGeometry x="1445" y="830" width="300" height="30" as="geometry"/></mxCell><mxCell id="lgs0" value="" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe08a;strokeColor=#d6b656;fontStyle=1;fontFamily=TH SarabunPSK;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1445" y="866" width="70" height="30" as="geometry"/></mxCell><mxCell id="lgt0" value="ตารางหลัก" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1530" y="864" width="300" height="34" as="geometry"/></mxCell><mxCell id="lgs1" value="" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=TH SarabunPSK;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1445" y="910" width="70" height="30" as="geometry"/></mxCell><mxCell id="lgt1" value="ตารางรายละเอียด" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1530" y="908" width="300" height="34" as="geometry"/></mxCell><mxCell id="lgs2" value="" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontFamily=TH SarabunPSK;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1445" y="954" width="70" height="30" as="geometry"/></mxCell><mxCell id="lgt2" value="ตารางจากหมวดอื่น" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1530" y="952" width="300" height="34" as="geometry"/></mxCell><mxCell id="lgr" value="1 / N = ฝั่งแม่ : ฝั่งลูก" style="text;html=1;align=left;verticalAlign=middle;fontFamily=TH SarabunPSK;fontSize=22;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1445" y="994" width="300" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>