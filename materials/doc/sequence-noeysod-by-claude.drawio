ry></mxCell><mxCell id="uc-reg-05-M11" value="แสดงคำสั่งที่ดำเนินการได้&lt;br&gt;พร้อมจำนวนนักเรียนที่เลือกไว้" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="435" as="sourcePoint"/><mxPoint x="170" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M12" value="เลือกคำสั่งบันทึกการย้ายออก ลาออก&lt;br&gt;หรือปรับสถานะการพ้นสภาพ" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="509" as="sourcePoint"/><mxPoint x="510" y="509" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M13" value="แสดงรายชื่อนักเรียนที่จะดำเนินการ" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="568" as="sourcePoint"/><mxPoint x="170" y="568" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M14" value="นำรายชื่อนักเรียนบางคนออกจากรายการก่อนยืนยัน" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="677" as="sourcePoint"/><mxPoint x="510" y="677" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M15" value="คำนวณยอดจำนวนที่จะดำเนินการให้ตรงกับรายการที่เหลือ&lt;br&gt;(ทำในเบราว์เซอร์)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="751" as="sourcePoint"/><mxPoint x="170" y="751" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M16" value="ระบุประเภท (ย้ายสถานศึกษา ลาออก&lt;br&gt;พักการเรียน หรือพ้นสภาพ)&lt;br&gt;สถานศึกษาปลายทาง และเหตุผล" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="864" as="sourcePoint"/><mxPoint x="510" y="864" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M17" value="POST&lt;br&gt;/api/admission/students/withdrawals/preview" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="938" as="sourcePoint"/><mxPoint x="850" y="938" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M18" value="อ่านข้อมูลนักเรียนที่เลือกเพื่อสรุปการเปลี่ยนแปลง" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="997" as="sourcePoint"/><mxPoint x="1190" y="997" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M19" value="ข้อมูลที่อ่านได้" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1056" as="sourcePoint"/><mxPoint x="850" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M20" value="สรุปการเปลี่ยนแปลงทั้งหมด" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontFamily=Tahoma;fontSize=11;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="1115" as="sourcePoint"/><mxPoint x="510" y="1115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="uc-reg-05-M21" value="แสดงสรุปให้ตรวจสอบก่อนยืนยัน" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fo